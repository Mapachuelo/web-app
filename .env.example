# Copiar a .env y completar (el .env lo administra el despliegue, no se versiona).

# Conexion a PostgreSQL. Dentro del pod, la base escucha en 127.0.0.1.
DATABASE_URL="postgresql://syncapp:cambia_esta_password@127.0.0.1:5432/syncapp?schema=public"

# Credenciales del contenedor postgres (deben coincidir con DATABASE_URL).
POSTGRES_USER="syncapp"
POSTGRES_PASSWORD="cambia_esta_password"
POSTGRES_DB="syncapp"

# Clave que envia la APK en el header X-Api-Key.
API_KEY="cambia_esta_api_key"

# Origenes permitidos por CORS para /api/* (la app Capacitor en navegador o WebView
# llama cross-origin). "*" = cualquiera; o lista separada por comas:
# CORS_ORIGINS="http://127.0.0.1:8080,https://localhost"
CORS_ORIGINS="*"

# Puerto loopback donde el pod publica Next.js (uso interno, nginx hace proxypass).
APP_PORT=3000

# Puerto aleatorio del host donde nginx recibe las conexiones http de la APK.
WEB_PORT=48123

# Reservadas para fases siguientes (panel admin y subida de archivos).
SESSION_SECRET="cambia_este_secreto"
UPLOAD_DIR="/data/uploads"
